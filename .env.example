# Sync server URL, baked into the app build so users never type it. Set this to
# your Railway domain so More → Account just needs an email + password.
# The app works fully offline if this is unset (sign-in is then unavailable, and
# if left blank the Account screen falls back to asking for the URL).
# Accounts + the AI coach are configured server-side (JWT_SECRET, GEMINI_API_KEY);
# no secrets belong in this file — see server/README.md.
EXPO_PUBLIC_SYNC_URL=
