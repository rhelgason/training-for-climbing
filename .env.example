# Cloud sync (optional). Copy to .env to prefill the sync server URL.
# The app works fully offline if this is unset; the URL + token can also be
# entered in-app under More → Cloud sync. The token is NOT stored here.
# The AI coach is configured server-side (GEMINI_API_KEY on the sync server),
# so no LLM key is needed here — see server/README.md.
EXPO_PUBLIC_SYNC_URL=
