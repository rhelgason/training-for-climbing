{
  "name": "training-for-climbing",
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "dev": "npm run dev --workspace @tfc/web",
    "build": "npm run build --workspace @tfc/web",
    "start": "npm run start --workspace @tfc/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck:core && npm run typecheck:web",
    "test": "npm run test:core && npm run test:web",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dev:web": "npm run dev --workspace @tfc/web",
    "build:web": "npm run build --workspace @tfc/web",
    "typecheck:core": "npm run typecheck --workspace @tfc/core",
    "test:core": "npm run test --workspace @tfc/core",
    "test:core:coverage": "npm run test:coverage --workspace @tfc/core",
    "typecheck:web": "npm run typecheck --workspace @tfc/web",
    "test:web": "npm run test --workspace @tfc/web",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,js}": [
      "prettier --write"
    ]
  },
  "private": true
}
