# Local development config for the web app. Copy to `.env.local` (git-ignored).
#
# The same three variables are set in Vercel → Project → Settings → Environment
# Variables for production, which is the source of truth if this file is ever
# lost — copy the values back from there rather than generating new ones.

# Neon Postgres. Use the POOLED connection string here and in Vercel (the host
# containing "-pooler"); many short-lived serverless functions against the
# direct endpoint will exhaust Neon's connection limit.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Signs session tokens. Must match whatever production uses, or every existing
# sign-in breaks — tokens live for a year. `openssl rand -hex 32` only when
# starting fresh.
JWT_SECRET=

# AI coach. Any one key turns it on. The rest are backups, tried in this
# order when the one before it fails (dead model, quota, timeout, bad JSON).
# Leave LLM_PROVIDER unset so Gemini stays first. Redeploy after adding a key.
# There is no switch for this on the phone.
#
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# Free models only (`:free` ids, price ceiling 0). About 50 requests/day.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Workers AI. Both are required. About 10,000 neurons/day.
# https://dash.cloudflare.com — account id is on the Workers overview;
# create a token with Workers AI read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. https://console.mistral.ai
MISTRAL_API_KEY=
# Optional and not free. Tried last, only when the free providers all fail.
# https://console.x.ai
# XAI_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL is only read for Groq, and retired ids are ignored.
# Gemini always uses gemini-3.6-flash, then gemini-3.5-flash if that id 404s.
# LLM_MODEL=

# Optional. Set to `disable` for a plaintext local Postgres instead of Neon.
# PGSSL=disable
