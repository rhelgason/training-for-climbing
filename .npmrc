# Kept from when the React Native tree lived here and had a benign peer conflict
# (react-reconciler wanting react ^19.2 against our pinned 19.1). That tree is
# gone, so this flag may now be unnecessary — but confirming that needs a
# networked install to prove no ERESOLVE appears on a strict installer like
# Vercel's, so it stays until someone can check.
legacy-peer-deps=true
