# The repo root is both the Expo mobile app and the npm-workspaces root, so any
# install pulls the whole React Native tree. That tree has a benign peer conflict
# (react-reconciler wants react ^19.2; we pin 19.1). legacy-peer-deps keeps that a
# warning instead of a hard ERESOLVE failure on strict installers (e.g. Vercel).
legacy-peer-deps=true
